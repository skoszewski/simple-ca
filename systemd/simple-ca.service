[Unit]
Description=simple-ca HTTP server of the CA certificates, CRLs and web pages
Documentation=https://github.com/skoszewski/simple-ca
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=simple-ca
Group=simple-ca
ExecStart=/usr/local/bin/simple-ca serve --ca-dir /etc/simple-ca --address 0.0.0.0 --port 8080 --webui
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/simple-ca
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
