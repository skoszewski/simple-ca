{
  "profiles": [
    {
      "name": "ca-admin",
      "token": {
        "valid": "8h",
        "scopes": [
          "tokens",
          "certs"
        ]
      }
    },
    {
      "name": "web-signer",
      "ca": "servers",
      "token": {
        "valid": "1h",
        "scopes": ["sign"],
        "domains": ["lab.example.org"]
      }
    }
  ],
  "rules": [
    {
      "users": ["alice@example.com"],
      "profile": "ca-admin"
    },
    {
      "groups": ["pki-admins"],
      "profile": "ca-admin"
    },
    {
      "groups": ["web-team"],
      "profile": "web-signer"
    }
  ]
}
