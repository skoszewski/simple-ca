[Unit]
Description=simple-ca-mini HTTP server of the CA certificates
Documentation=https://github.com/skoszewski/simple-ca
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=simple-ca
Group=simple-ca
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/simple-ca-mini serve --ca-dir /etc/simple-ca --address 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
