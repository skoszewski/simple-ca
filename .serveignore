# serve-markdown shows README.md, CHANGELOG.md, docs/ and the documents of examples/ of this
# repository.

# Scratch files, test CAs and build outputs, which .gitignore leaves out of the repository.
/tmp/
/ca/
/build/
/dist/

# Folders without documents.
/assets/
/systemd/

# The examples, but for their documents.
/examples/*
!/examples/federation/
/examples/federation/*
!/examples/federation/*.md
